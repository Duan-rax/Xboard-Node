# Xboard Node Configuration
# Top-level settings are inherited by all instances. Instance overrides take precedence.

# ── Single node (simplest) ──
# panel:
#   url: "https://panel.example.com"
#   token: "your-api-key"
#   node_id: 1

# ── Multiple instances ──
# kernel:
#   type: "singbox"
#   # Xray-only local access log, used by traffic-audit collectors.
#   # xray_access_log: "/var/log/xboard-node/xray-access.log"
#   # Xray-only Reality runtime overrides. Keep the panel Reality dest public
#   # for subscription generation, then point the node at a local Nginx/Caddy
#   # listener that accepts PROXY protocol.
#   # xray_reality_dest_override: "127.0.0.1:8001"
#   # xray_reality_xver: 1
#   # Machine-mode audit: one private Clash API is generated for every panel
#   # node (base port + panel node ID). The collector reads the manifest, so
#   # it does not need manually maintained node targets.
#   # singbox_audit_api_enabled: true
#   # singbox_audit_api_base_port: 19090
#   # singbox_audit_api_secret: "replace-with-a-long-local-secret"
#   # audit_manifest_path: "/etc/xboard-node/traffic-audit-targets.json"
# log:
#   level: "info"
# instances:
#   - panel:
#       url: "https://panel.example.com"
#       token: "api-key-1"
#       node_id: 1
#   - panel:
#       url: "https://panel.example.com"
#     machine:
#       machine_id: 2
#       token: "machine-token-2"
#     log:
#       level: "debug"   # override for this instance only

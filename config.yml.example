# Xboard Node Configuration
# Top-level settings are inherited by all instances. Instance overrides take precedence.

# ── Single node (simplest) ──
# panel:
#   url: "https://panel.example.com"
#   token: "your-api-key"
#   node_id: 1

# ── Multiple instances ──
# kernel:
#   type: "singbox"
#   # Xray-only local access log for diagnostics.
#   # xray_access_log: "/var/log/xboard-node/xray-access.log"
#   # Xray routing strategy when IP/CIDR rules need a resolved destination.
#   # domain_strategy: "AsIs" # AsIs | IPIfNonMatch | IPOnDemand
#   # Xray-only Reality runtime overrides. Keep the panel Reality dest public
#   # for subscription generation, then point the node at a local Nginx/Caddy
#   # listener that accepts PROXY protocol.
#   # xray_reality_dest_override: "127.0.0.1:8001"
#   # xray_reality_xver: 1
#   # Geo data source. Defaults to MetaCubeX for both kernels.
#   # geo_data_provider: "metacubex"    # metacubex | loyalsoldier | sagernet | custom
#   # geo_rule_set_provider: "metacubex" # metacubex | sagernet | custom
#   # geo_data_variant: "full"           # full | lite (MetaCubeX only)
#   # geoip_data_url: "https://example.com/geoip.dat"
#   # geosite_data_url: "https://example.com/geosite.dat"
#   # geoip_rule_set_url: "https://example.com/geoip/{tag}.srs"
#   # geosite_rule_set_url: "https://example.com/geosite/{tag}.srs"
# log:
#   level: "info"
# instances:
#   - panel:
#       url: "https://panel.example.com"
#       token: "api-key-1"
#       node_id: 1
#   - panel:
#       url: "https://panel.example.com"
#     machine:
#       machine_id: 2
#       token: "machine-token-2"
#     log:
#       level: "debug"   # override for this instance only
